ARG GO_BUILDER_IMAGE=golang:1.26.1-alpine
ARG RUNTIME_IMAGE=new-api-runtime-base:bookworm-slim-amd64

FROM ${GO_BUILDER_IMAGE} AS builder
ENV GO111MODULE=on \
    CGO_ENABLED=0 \
    GOTOOLCHAIN=local \
    GOEXPERIMENT=greenteagc \
    GOPROXY=file:///offline/gomodproxy,off \
    GOSUMDB=off

ARG TARGETOS=linux
ARG TARGETARCH=amd64
ENV GOOS=${TARGETOS} GOARCH=${TARGETARCH}

WORKDIR /build

COPY offline/gomodproxy /offline/gomodproxy
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN test -f web/default/dist/index.html && test -f web/classic/dist/index.html
RUN go build -ldflags "-s -w -X 'github.com/QuantumNous/new-api/common.Version=$(cat VERSION)'" -o new-api

FROM ${RUNTIME_IMAGE}

COPY --from=builder /build/new-api /new-api
COPY LICENSE NOTICE THIRD-PARTY-LICENSES.md /licenses/
EXPOSE 3000
WORKDIR /data
ENTRYPOINT ["/new-api"]
